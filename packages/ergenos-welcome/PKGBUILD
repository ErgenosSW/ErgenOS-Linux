# Maintainer: ErgenOS Project <https://github.com/ErgenosSW>

pkgname=ergenos-welcome
pkgver=1.0.1
pkgrel=1
pkgdesc='First-login welcome application for ErgenOS'
arch=('any')
url='https://github.com/ErgenosSW/ErgenOS-Welcome'
license=('GPL-3.0-or-later')
depends=(
  'gtk4'
  'libadwaita'
  'python'
  'python-gobject'
)
makedepends=('meson')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('4486f98cc69ea672c70dee8c5341b07d16fe0029cf8ac7e2172f367390102602')

build() {
  arch-meson "ErgenOS-Welcome-${pkgver}" build
  meson compile -C build
}

check() {
  cd "ErgenOS-Welcome-${pkgver}"
  PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=src python -m unittest discover -s tests -v
}

package() {
  meson install -C build --destdir "${pkgdir}"
  install -Dm644 "ErgenOS-Welcome-${pkgver}/LICENSE" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
