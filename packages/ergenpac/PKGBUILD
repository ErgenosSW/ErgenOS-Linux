# Maintainer: ErgenOS Project <https://github.com/ErgenosSW>

pkgname=ergenpac
pkgver=0.2.4
pkgrel=1
pkgdesc='Graphical package manager and system updater for ErgenOS'
arch=('any')
url='https://github.com/ErgenosSW/ErgenPac'
license=('GPL-3.0-or-later')
depends=(
  'ergenctl>=1.1.0.dev-9'
  'flatpak'
  'gtk4'
  'libadwaita'
  'pacman'
  'pacman-contrib'
  'pciutils'
  'polkit'
  'python'
  'python-gobject'
)
makedepends=('meson')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('e86bbbaf61cd318470efa74cb6a1a31a59acd9db90fb6c70c295bf5a51525b3d')
_builddir="build-${pkgver}"

build() {
  arch-meson "ErgenPac-${pkgver}" "${_builddir}"
  meson compile -C "${_builddir}"
}

check() {
  cd "ErgenPac-${pkgver}"
  PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=src python -m unittest discover -s tests -v
}

package() {
  meson install -C "${_builddir}" --destdir "${pkgdir}"
  install -Dm644 "ErgenPac-${pkgver}/LICENSE" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
