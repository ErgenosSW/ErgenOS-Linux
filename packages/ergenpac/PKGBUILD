# Maintainer: Szymon Pilip <szymon.pilip@ergenos.dev>

pkgname=ergenpac
pkgver=1.0.1
pkgrel=3
pkgdesc='Graphical package manager and system updater for ErgenOS'
arch=('any')
url='https://github.com/ErgenosSW/ErgenPac'
license=('GPL-3.0-or-later')
depends=(
  'ergenctl>=1.1.0.dev-9'
  'fakeroot'
  'flatpak'
  'gtk4'
  'libadwaita'
  'pacman'
  'pacman-contrib'
  'pciutils'
  'polkit'
  'python'
  'python-gobject'
)
makedepends=('meson')
_source_commit=f1a89b885d1f2a9c3b100b47bfdc86fd508868b6
_source_dir="ErgenPac-${_source_commit}"
source=("${pkgname}-${_source_commit}.tar.gz::${url}/archive/${_source_commit}.tar.gz")
sha256sums=('32a29d7271ec4dee6ccfb11044e5e1d32b153b5741b783423f784fc5f07e8828')
_builddir="build-${_source_commit}"

build() {
  arch-meson "${_source_dir}" "${_builddir}"
  meson compile -C "${_builddir}"
}

check() {
  cd "${_source_dir}"
  PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=src python -m unittest discover -s tests -v
}

package() {
  meson install -C "${_builddir}" --destdir "${pkgdir}"
  install -Dm644 "${_source_dir}/LICENSE" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
