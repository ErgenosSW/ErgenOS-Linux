# The hybrid ErgenOS ISO is already mounted by archiso. Some virtual optical
# drives cannot expose its GPT partitions directly, which makes systemd try a
# redundant loop attachment and print a harmless failure during live boot.
ACTION=="add|change", SUBSYSTEM=="block", ENV{ID_CDROM}=="1", ENV{ID_PART_GPT_AUTO_ROOT_DISK_NEEDS_LOOP}="0"
