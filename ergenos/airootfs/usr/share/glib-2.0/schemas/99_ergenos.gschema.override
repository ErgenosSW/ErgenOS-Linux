[org.gnome.login-screen]
logo='/usr/share/pixmaps/ergenos-gdm-logo.png'

[org.gnome.desktop.background]
picture-uri='file:///usr/share/backgrounds/ergenos/ergenos-wallpaper.png'
picture-uri-dark='file:///usr/share/backgrounds/ergenos/ergenos-wallpaper.png'
picture-options='zoom'

[org.gnome.desktop.screensaver]
picture-uri='file:///usr/share/backgrounds/ergenos/ergenos-wallpaper.png'
picture-options='zoom'

[org.gnome.shell]
enabled-extensions=['dash-to-dock@micxgx.gmail.com', 'blur-my-shell@aunetx', 'arcmenu@arcmenu.com', 'caffeine@patapon.info', 'gtk4-ding@smedius.gitlab.com']

[org.gnome.shell.extensions.arcmenu]
menu-button-icon='/usr/share/pixmaps/ergenos-logo.png'
menu-button-icon-size=28

[org.gnome.shell.extensions.dash-to-dock]
background-opacity=0.8
dash-max-icon-size=48
dock-fixed=true
dock-position='BOTTOM'
height-fraction=0.9
preferred-monitor=-2
preferred-monitor-by-connector='primary'

[org.gnome.shell.extensions.blur-my-shell]
rounded-blur-found=false
settings-version=2

[org.gnome.shell.extensions.blur-my-shell.appfolder]
brightness=0.6
sigma=30

[org.gnome.shell.extensions.blur-my-shell.dash-to-dock]
blur=true
brightness=0.6
sigma=30
static-blur=true
style-dash-to-dock=0

[org.gnome.shell.extensions.blur-my-shell.panel]
brightness=0.6
corner-radius=0
sigma=30

[org.gnome.shell.extensions.blur-my-shell.window-list]
brightness=0.6
sigma=30

[org.gnome.shell.extensions.caffeine]
cli-toggle=true
countdown-timer=0
indicator-position-max=2
restore-state=true
user-enabled=true

[org.gnome.shell.extensions.gtk4-ding]
start-corner='bottom-left'
