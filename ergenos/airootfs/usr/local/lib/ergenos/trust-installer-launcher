#!/usr/bin/env bash

set -euo pipefail

launcher="${HOME}/Desktop/Install ErgenOS.desktop"

[[ "$(id -un)" == "ergenos" ]] || exit 0
[[ -f "${launcher}" ]] || exit 0

chmod u+x "${launcher}"

for attempt in {1..20}; do
    if gio set "${launcher}" metadata::trusted true 2>/dev/null \
        && gio info -a metadata::trusted "${launcher}" 2>/dev/null \
            | grep -Fq 'metadata::trusted: true'; then
        exit 0
    fi
    sleep 0.5
done

exit 0
